/* 全局样式 —— 深色主题，移动端安全区适配 */

:root {
  --bg: #0b0d17;
  --bg-elevated: #141833;
  --bg-elevated-2: #1b2044;
  --border: rgba(255, 255, 255, 0.1);
  --text: #ffffff;
  --text-dim: rgba(255, 255, 255, 0.56);
  --accent: #4cc9f0;
  --accent-2: #7b2ff7;
  --danger: #f72585;
  --success: #4ade80;
  --warning: #f9c74f;

  color-scheme: dark;
}

* {
  box-sizing: border-box;
}

html,
body,
#root {
  height: 100%;
  margin: 0;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: system-ui, -apple-system, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  /* 防止移动端点击时出现灰色高亮块 */
  -webkit-tap-highlight-color: transparent;
  overscroll-behavior: none;
}

.app {
  display: flex;
  flex-direction: column;
  height: 100%;
  /* iPhone 刘海/底部横条避让 */
  padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom)
    env(safe-area-inset-left);
}

.screen {
  flex: 1;
  overflow-y: auto;
  padding: 24px 20px;
  max-width: 720px;
  width: 100%;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 18px;
}

h1 {
  font-size: 26px;
  margin: 0;
  letter-spacing: -0.02em;
}

h2 {
  font-size: 17px;
  margin: 0 0 8px;
  font-weight: 600;
}

p {
  line-height: 1.65;
  color: var(--text-dim);
  margin: 0;
  font-size: 14px;
}

.muted {
  color: var(--text-dim);
  font-size: 13px;
}

.brand {
  font-size: 30px;
  font-weight: 700;
  letter-spacing: -0.03em;
  background: linear-gradient(120deg, var(--accent), var(--accent-2));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.card {
  background: var(--bg-elevated);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 16px;
}

button {
  font: inherit;
  font-weight: 600;
  color: var(--text);
  background: var(--bg-elevated-2);
  border: 1px solid var(--border);
  border-radius: 11px;
  padding: 12px 18px;
  cursor: pointer;
  transition: filter 0.15s, transform 0.06s;
  /* 手机上按钮至少 44px 高，符合触摸目标尺寸 */
  min-height: 44px;
}

button:hover:not(:disabled) {
  filter: brightness(1.18);
}

button:active:not(:disabled) {
  transform: scale(0.98);
}

button:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

button.primary {
  background: linear-gradient(120deg, var(--accent), var(--accent-2));
  border: none;
  color: #06080f;
}

button.ghost {
  background: transparent;
}

.row {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.row.tight {
  gap: 8px;
}

.seg {
  display: flex;
  border: 1px solid var(--border);
  border-radius: 11px;
  overflow: hidden;
}

.seg button {
  flex: 1;
  border: none;
  border-radius: 0;
  background: transparent;
  padding: 11px 8px;
}

.seg button[data-active='true'] {
  background: linear-gradient(120deg, var(--accent), var(--accent-2));
  color: #06080f;
}

.progress {
  height: 6px;
  background: var(--bg-elevated-2);
  border-radius: 3px;
  overflow: hidden;
}

.progress > div {
  height: 100%;
  background: linear-gradient(90deg, var(--accent), var(--accent-2));
  transition: width 0.25s ease;
}

/* 游戏画布：touch-action:none 是必须的，否则多点触摸会触发页面滚动/缩放 */
.game-canvas {
  display: block;
  width: 100%;
  height: 100%;
  touch-action: none;
  user-select: none;
  -webkit-user-select: none;
  -webkit-touch-callout: none;
}

.game-host {
  flex: 1;
  position: relative;
  overflow: hidden;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(96px, 1fr));
  gap: 10px;
}

.stat {
  background: var(--bg-elevated-2);
  border-radius: 10px;
  padding: 10px 12px;
}

.stat .k {
  font-size: 12px;
  color: var(--text-dim);
}

.stat .v {
  font-size: 20px;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.badge {
  display: inline-block;
  font-size: 12px;
  padding: 3px 9px;
  border-radius: 999px;
  border: 1px solid var(--border);
}

.badge.good {
  color: var(--success);
  border-color: rgba(74, 222, 128, 0.4);
}

.badge.warn {
  color: var(--warning);
  border-color: rgba(249, 199, 79, 0.4);
}

.badge.bad {
  color: var(--danger);
  border-color: rgba(247, 37, 133, 0.4);
}

.note {
  font-size: 13px;
  line-height: 1.6;
  color: var(--text-dim);
  border-left: 2px solid var(--border);
  padding-left: 10px;
}

.grade {
  font-size: 68px;
  font-weight: 800;
  line-height: 1;
  background: linear-gradient(120deg, var(--accent), var(--accent-2));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

input[type='range'] {
  width: 100%;
  accent-color: var(--accent);
}

.overlay {
  position: fixed;
  inset: 0;
  background: rgba(6, 8, 15, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  text-align: center;
  z-index: 50;
}
